# Copy this file to .env for local development and replace the placeholders.
# Never commit real credentials. Variables prefixed with NEXT_PUBLIC_ are sent
# to the browser, so API keys and other secrets must never use that prefix.

# =============================================================================
# Authentication (required)
# =============================================================================
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized redirect URI for local development:
#   http://localhost:3000/api/auth/callback/google
# Add the equivalent HTTPS callback URI for every deployed domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate with: openssl rand -base64 32
# Use the same value across all instances of one deployment.
AUTH_SECRET=""

# Auth.js normally infers the deployment host. Only set AUTH_URL when needed.
# Never configure localhost as AUTH_URL in a Vercel Production environment.
# AUTH_URL="http://localhost:3000"

# =============================================================================
# Agora (required)
# =============================================================================
# Public project identifier from Agora Console.
NEXT_PUBLIC_AGORA_APP_ID=""

# Server-only App Certificate used to create RTC and RTM tokens.
AGORA_APP_CERTIFICATE=""

# Server-only REST credentials used by the Conversational AI lifecycle routes.
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""

# Optional debugging. Full invite payloads may contain sensitive configuration;
# leave disabled unless actively troubleshooting.
# AGORA_LOG_PAYLOAD_VERBOSE="false"

# =============================================================================
# Agora telephony (optional)
# =============================================================================
# Server-only Agent Studio V2 gateway base URL supplied by Agora.
# Do not append /v2; the application adds the endpoint path.
AGENT_STUDIO_V2_BASE_URL="https://api.agora.io/conversational-ai"

# Phone-number record used as the outbound caller. Configure the SIP number in
# Agora Console, then copy number_id from:
#   GET {AGENT_STUDIO_V2_BASE_URL}/v2/phone-numbers?page=1&page_size=100
# This is the number_id, not the E.164 phone number or a Studio pipeline ID.
AGORA_TELEPHONY_PHONE_NUMBER_ID=""

# =============================================================================
# Conversational AI pipeline
# =============================================================================
# The browser receives provider names and non-secret defaults. API keys remain
# server-only and are injected by app/api/agent/invite/route.ts.

# LLM -------------------------------------------------------------------------
# Supported UI providers include openai, azure_openai, anthropic, gemini, groq,
# coze, dify, minimax, xai, amazon_bedrock, google_vertex_ai, and custom.
NEXT_PUBLIC_LLM_VENDOR="openai"
NEXT_PUBLIC_LLM_URL="https://api.openai.com/v1/chat/completions"
NEXT_PUBLIC_LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# Amazon Bedrock BYOK. These are server-only fallbacks for the protected
# settings fields. BEDROCK_API_KEY is the Bedrock long-term API key; the AWS
# access key pair is supplied separately because Agora's adapter requires both.
BEDROCK_API_KEY=""
BEDROCK_AWS_ACCESS_KEY_ID=""
BEDROCK_AWS_SECRET_ACCESS_KEY=""

# Google Vertex AI BYOK. Supply a current Google Cloud OAuth access token.
# Project ID, location, and model are non-secret fields configured in Settings.
GOOGLE_VERTEX_ACCESS_TOKEN=""

# TTS -------------------------------------------------------------------------
# Select any TTS provider exposed by the playground.
NEXT_PUBLIC_TTS_VENDOR="elevenlabs"

# ElevenLabs BYOK TTS and Instant Voice Cloning. ELEVENLABS_API_KEY stays
# server-side when the Settings API Key field is left empty.
# The voice ID below is the app's Jessica fallback voice.
NEXT_PUBLIC_ELEVENLABS_VOICE_ID="cgSgspJ2msm6clMCkdW9"
NEXT_PUBLIC_ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
NEXT_PUBLIC_ELEVENLABS_SAMPLE_RATE="24000"
ELEVENLABS_API_KEY=""

# Microsoft Azure Speech defaults.
NEXT_PUBLIC_MICROSOFT_TTS_REGION="eastus"
NEXT_PUBLIC_MICROSOFT_TTS_VOICE="en-US-AndrewMultilingualNeural"
MICROSOFT_TTS_KEY=""

# OpenAI TTS defaults.
NEXT_PUBLIC_OPENAI_TTS_MODEL="tts-1"
NEXT_PUBLIC_OPENAI_TTS_VOICE="alloy"
OPENAI_TTS_KEY=""

# MiniMax BYOK TTS and voice cloning. Both values stay server-side. The API
# key is used by the clone route and Agora TTS; the group ID is required by
# Agora's MiniMax BYOK TTS configuration.
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# Sarvam TTS. The UI supplies editable Bulbul v2 parameter placeholders;
# enter the key in Settings or set this server-only fallback.
SARVAM_TTS_KEY=""

# ASR -------------------------------------------------------------------------
# Default provider includes ares, deepgram, microsoft, and gemini.
NEXT_PUBLIC_ASR_VENDOR="deepgram"
NEXT_PUBLIC_ASR_LANGUAGE="en-US"

# Deepgram ASR settings. DEEPGRAM_API_KEY is also the fallback key for
# Deepgram TTS; set DEEPGRAM_TTS_KEY separately only when the keys differ.
NEXT_PUBLIC_DEEPGRAM_URL="wss://api.deepgram.com/v1/listen"
NEXT_PUBLIC_DEEPGRAM_MODEL="nova-2"
NEXT_PUBLIC_DEEPGRAM_LANGUAGE="en"
DEEPGRAM_API_KEY=""
# DEEPGRAM_TTS_KEY=""

# Microsoft Azure Speech recognition settings.
NEXT_PUBLIC_MICROSOFT_ASR_REGION="eastus"
MICROSOFT_ASR_KEY=""

# OpenAI speech recognition. When empty, the server falls back to the shared
# OPENAI_API_KEY declared in the MLLM section below.
OPENAI_ASR_KEY=""

# Gemini ASR is an early-access BYOK provider. It uses the preview join
# endpoint with the agora-feature: gemini-live header. GEMINI_API_KEY below is
# shared with the optional Gemini MLLM configuration.

# MLLM (optional) -------------------------------------------------------------
# Used only when voice-to-voice MLLM is enabled in Advanced Settings.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# =============================================================================
# AI avatars (optional)
# =============================================================================
# Leave an avatar provider's values empty when that provider is not used.

# HeyGen / LiveAvatar requires a streaming avatar ID and 24 kHz TTS.
NEXT_PUBLIC_HEYGEN_AVATAR_ID=""
NEXT_PUBLIC_HEYGEN_QUALITY="medium"
HEYGEN_API_KEY=""

# Akool requires 16 kHz TTS.
NEXT_PUBLIC_AKOOL_AVATAR_ID=""
AKOOL_API_KEY=""

# Anam avatar IDs are UUIDs; Anam requires 24 kHz TTS.
NEXT_PUBLIC_ANAM_AVATAR_ID=""
ANAM_API_KEY=""

# LemonSlice uses a publicly accessible HTTP(S) portrait image as avatar_id.
NEXT_PUBLIC_LEMONSLICE_AVATAR_ID="https://lemonslice.com/flash-test.jpg"
NEXT_PUBLIC_LEMONSLICE_API_BASE_URL="https://lemonslice.com/api/liveai/agora"
NEXT_PUBLIC_LEMONSLICE_QUALITY="high"
NEXT_PUBLIC_LEMONSLICE_AREA="NORTH_AMERICA"
LEMONSLICE_API_KEY=""
